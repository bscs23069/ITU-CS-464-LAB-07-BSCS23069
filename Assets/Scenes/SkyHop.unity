      m_Calls: []
  m_text: '<size=120><color=#FFC93C><b>SKY HOP</b></color></size>

    <color=#AEB8E6>a
    CS464 Lab 07 menu system</color>


    <color=#AEB8E6>DESIGN, CODE & ART</color>

    <b>Mayasa
    Fakhar</b>

    BSCS23069


    <color=#AEB8E6>FONTS</color>

    Lilita One
    by Juan Montoreano

    Poppins by Indian Type Foundry

    <size=36>both under
    the SIL Open Font License</size>


    <color=#AEB8E6>ICONS & SPRITES</color>

    Drawn
    in code with Python (Pillow)

    for this project


    <color=#AEB8E6>SOUND</color>

    Made
    in code at runtime


    <color=#AEB8E6>INSPIRED BY</color>

    Crossy Road
    (Hipster Whale)

    <size=36>character carousel</size>

    Cut the Rope (ZeptoLab)

    <size=36>level
    grid with stars</size>

    Alto''s Adventure (Snowman)

    <size=36>calm pause
    and settings cards</size>


    <color=#AEB8E6>COURSE</color>

    CS464 Game
    Development

    ITU, Fall 2026


    <color=#AEB8E6>THANK YOU FOR PLAYING</color>'
